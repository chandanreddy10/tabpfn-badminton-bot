# Copy to .env and fill in. Token: https://platform.priorlabs.ai/account/api-keys
TABPFN_TOKEN=

# Where TabPFN runs: local (default, open weights on this machine) | api (Prior Labs API, TabPFN-3.5)
# TABPFN_BACKEND=local
# If the API is chosen but unavailable (no token, quota, network): local (default) = download TabPFN-3.5 from
# Hugging Face and run it here instead; none = pause until the API is back
# TABPFN_FALLBACK=local
# Local checkpoint from huggingface.co/Prior-Labs/tabpfn_3_5: v3.5 (default) | v3.5-fast | v3.5-multiclass
# TABPFN_MODEL=v3.5
# Local device: auto (CUDA, then MPS, then CPU) | mps | cuda | cpu
# TABPFN_DEVICE=auto
# Where local weights are stored (default: the tabpfn cache directory)
# TABPFN_MODEL_CACHE_DIR=

# TABPFN_N_ESTIMATORS=4
# TABPFN_MOCK=1
# PORT=8000
